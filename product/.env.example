# 双引擎默认策略：优先 Codex 的 ChatGPT 订阅，不可用时回退 OpenAI API。
AI_RESEARCH_ENGINE=auto

# 可选备用：从 https://platform.openai.com/api-keys 创建。不要把本文件发给其他人。
OPENAI_API_KEY=

# 日常研究默认使用平衡质量与成本的模型；复杂公司研究会提高推理深度。
OPENAI_MODEL=gpt-5.6-terra

# 一般无需修改；首次配置会自动找到 Codex。Windows 可填写 codex.cmd 的完整路径。
CODEX_BIN=
CODEX_MODEL=

# 网页只监听本机，不向局域网或互联网开放。
AI_RESEARCH_HOST=127.0.0.1
AI_RESEARCH_PORT=8765

# 自动更新：默认每 6 小时检查固定的 GitHub Release 仓库。
# 更新包永远不覆盖 .env、数据库、对话、报告、偏好、自选和纠正记录。
AUTO_UPDATE_ENABLED=1
AUTO_UPDATE_INTERVAL_HOURS=6
UPDATE_REPOSITORY=Leobai03/ai-investment-employee-updates
